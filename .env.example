# ============================================================
# StockFacture Pro - Variables d'environnement
# ============================================================
# Copiez ce fichier en `.env` et remplissez les valeurs.
# NE JAMAIS COMMITER le fichier `.env` (il est dans .gitignore).
# ============================================================

# ------------------------------------------------------------
# 1. Firebase Configuration
# ------------------------------------------------------------
# Ces valeurs proviennent de la console Firebase :
#   Console → Paramètres du projet → Général → Vos applications → Web
#
# Note : le projet utilise un fichier séparé
#   `firebase-applet-config.json`
# pour stocker la config Firebase. Voir le README pour les détails.
#
# Si vous préférez utiliser des variables d'environnement, utilisez :
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# ------------------------------------------------------------
# 2. Application URL
# ------------------------------------------------------------
# URL publique de l'application (utilisée pour les liens auto-référents,
# les callbacks OAuth et les API). En développement : http://localhost:3000.
APP_URL="http://localhost:3000"

# ------------------------------------------------------------
# 3. Variables optionnelles
# ------------------------------------------------------------
# Google Gemini API (uniquement si vous utilisez les fonctionnalités IA)
# GEMINI_API_KEY=""

# Désactive le Hot Module Replacement pendant le développement
# (utile en environnement contraint). Valeur : "true" ou "false".
# DISABLE_HMR="false"